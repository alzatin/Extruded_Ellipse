      "codeVersion": 1,
      "code": "\n// Example Code\nconst Inputs = [\n  { inputName: \"minorRadius\", type: \"number\", defaultValue: 5 },\n  { inputName: \"majorRadius\", type: \"number\", defaultValue: 10 },\n  { inputName: \"height\", type: \"number\", defaultValue: 3 }\n];\n\n\nlet newPlane = replicad.makePlane()\nlet elliDraw = replicad.drawEllipse(majorRadius, minorRadius)\nlet sketchCir = elliDraw.sketchOnPlane(newPlane)\nlet elli = sketchCir.extrude(height)\n\nlet elliObj = {\n  geometry: [elli],\n  dimension: \"3D\",\n  tags: [\"createdShape\"],\n  color: '#A3CE5B',\n  plane: newPlane,\n  bom: [],\n}\n\nreturn elliObj\n\n/*let assembly = await Assembly([importedShape, cylObj]);\nreturn assembly;*/\n"
